{
	"luci-app-zig-dnsmasq": {
		"description": "Manage the Zig port of dnsmasq",
		"read": {
			"uci": [ "zig-dnsmasq" ],
			"file": {
				"/var/etc/zig-dnsmasq.conf": [ "read" ],
				"/var/log/zig-dnsmasq.log": [ "read" ]
			},
			"ubus": {
				"service": [ "list" ]
			}
		},
		"write": {
			"uci": [ "zig-dnsmasq" ],
			"file": {
				"/etc/init.d/zig-dnsmasq": [ "exec" ]
			}
		}
	}
}
